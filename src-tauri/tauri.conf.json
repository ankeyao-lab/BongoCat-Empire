{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BongoCat Empire",
  "version": "../package.json",
  "identifier": "com.harry.bongocat.arcana",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BongoCat Empire",
        "url": "index.html/#/",
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "maximizable": false,
        "width": 400,
        "height": 379
      },
      {
        "label": "preference",
        "url": "index.html/#/preference",
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 800,
        "minHeight": 620,
        "skipTaskbar": true,
        "title": "BongoCat Empire · Settings",
        "width": 1000,
        "height": 780
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "createUpdaterArtifacts": false,
    "targets": [
      "app"
    ],
    "shortDescription": "BongoCat Empire: nine-level wardrobes and local growth",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/tray.png",
      "assets/models"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
